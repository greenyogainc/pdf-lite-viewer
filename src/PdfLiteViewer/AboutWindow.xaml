<Window x:Class="PdfLiteViewer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PdfLiteViewer"
        Title="{local:Loc AboutWindowTitle}"
        Width="760" Height="850" MinWidth="560" MinHeight="480"
        Background="#FF404040"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="BarFg" Color="#FFDDDDDD"/>
        <SolidColorBrush x:Key="DimFg" Color="#FF9A9A9A"/>
        <SolidColorBrush x:Key="Accent" Color="#FF2D79C7"/>

        <!-- Same visual language as the toolbar buttons, plus a focus ring the toolbar
             does not need: this window is keyboard-first, so focus must be visible. -->
        <Style x:Key="FocusRing" TargetType="Control">
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="-2" StrokeThickness="1.5" Stroke="#FF9CC7EE"
                                               StrokeDashArray="1 2" RadiusX="4" RadiusY="4"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="DialogButton" BasedOn="{StaticResource FocusRing}">
            <Setter Property="Background" Value="#FF2B2B2B"/>
            <Setter Property="Foreground" Value="{StaticResource BarFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF505050"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DimFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF2A6FB0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF17466F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Web links: underlined text buttons, tooltip carries the target URL. -->
        <Style TargetType="Button" x:Key="LinkButton" BasedOn="{StaticResource FocusRing}">
            <Setter Property="Foreground" Value="#FF7AB8E8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SupportInput" TargetType="TextBox" BasedOn="{StaticResource FocusRing}">
            <Setter Property="Background" Value="#FF292929"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#FF626262"/>
            <Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="38"/><Setter Property="Margin" Value="0,0,0,14"/>
            <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FF81B7EC"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SupportLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource BarFg}"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Bottom bar: Back only exists while the support view is showing. -->
        <Border DockPanel.Dock="Bottom" Background="#FF2B2B2B">
            <DockPanel Margin="14,10" LastChildFill="False">
                <TextBlock x:Name="FooterHint" DockPanel.Dock="Left" Foreground="{StaticResource DimFg}"
                           FontSize="12" VerticalAlignment="Center"
                           Text="{local:Loc AboutPublisher}"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BackBtn" Style="{StaticResource DialogButton}" Content="{local:Loc AboutBack}"
                            Click="Back_Click" Visibility="Collapsed"/>
                    <Button x:Name="CloseBtn" Style="{StaticResource DialogButton}" Content="{local:Loc AboutClose}"
                            Click="Close_Click" IsCancel="True"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <!-- ===================== About ===================== -->
            <ScrollViewer x:Name="AboutPanel" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="28,24">
                    <StackPanel Orientation="Horizontal">
                        <!-- Component-qualified pack URI: a root-relative "/Assets/…" resolves
                             against the *entry* assembly, which under tools/HangProbe and
                             tools/StoreShots is not this one — the mark rendered blank there. -->
                        <Image x:Name="BrandMark" Width="72" Height="72" VerticalAlignment="Center"
                               Source="pack://application:,,,/PdfLiteViewer;component/Assets/greenyoga-mark.png"
                               AutomationProperties.Name="{local:Loc AboutLogoName}"/>
                        <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="{local:Loc AppTitle}" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VersionText" Foreground="{StaticResource BarFg}" FontSize="13" Margin="0,4,0,0"/>
                            <TextBlock Text="{local:Loc AboutPublisher}" Foreground="{StaticResource DimFg}" FontSize="13" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{local:Loc AboutPurpose}" Foreground="{StaticResource BarFg}"
                               FontSize="14" TextWrapping="Wrap" Margin="0,22,0,0"/>
                    <TextBlock Text="{local:Loc AboutLicenseLine}" Foreground="{StaticResource BarFg}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <Border Background="#FF383838" CornerRadius="6" Padding="16,12" Margin="0,20,0,0">
                        <TextBlock Text="{local:Loc AboutBrandBlurb}" Foreground="{StaticResource BarFg}"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <WrapPanel Margin="0,20,0,0">
                        <Button x:Name="WebsiteLink" Style="{StaticResource LinkButton}"
                                Content="{local:Loc AboutWebsite}" Click="Website_Click"/>
                        <Button x:Name="SoftwareLink" Style="{StaticResource LinkButton}"
                                Content="{local:Loc AboutMoreSoftware}" Click="Software_Click"/>
                        <Button x:Name="PrivacyLink" Style="{StaticResource LinkButton}"
                                Content="{local:Loc AboutPrivacy}" Click="Privacy_Click"/>
                        <Button x:Name="LicenseToggle" Style="{StaticResource LinkButton}"
                                Content="{local:Loc AboutViewLicense}" Click="License_Click"/>
                    </WrapPanel>

                    <TextBox x:Name="LicenseText" Visibility="Collapsed" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             Background="#FF1E1E1E" Foreground="{StaticResource BarFg}" BorderBrush="#FF4A4A4A"
                             FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" Padding="10"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="180"
                             AutomationProperties.Name="{local:Loc AboutViewLicense}"/>

                    <Button x:Name="ContactSupportBtn" Style="{StaticResource AccentButton}"
                            Content="{local:Loc AboutContactSupport}" Click="ContactSupport_Click"
                            HorizontalAlignment="Left" Margin="0,24,0,0" Padding="18,8"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SupportPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Border Background="#FF1E1E1E" BorderBrush="#FF4A4A4A" BorderThickness="1" CornerRadius="8" Padding="24" Margin="24" MaxWidth="640" TextElement.FontFamily="Segoe UI">
                    <StackPanel>
                        <TextBlock Text="{local:Loc AboutContactSupport}" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{local:Loc SupportIntro}" Foreground="{StaticResource BarFg}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,18"/>
                        <StackPanel x:Name="SupportForm">
                            <Label x:Name="SupportNameLabel" Content="{local:Loc SupportName}" Target="{Binding ElementName=SupportNameInput}" Style="{StaticResource SupportLabel}"/>
                            <TextBox x:Name="SupportNameInput" Style="{StaticResource SupportInput}" MaxLength="200" AutomationProperties.LabeledBy="{Binding ElementName=SupportNameLabel}"/>
                            <Label x:Name="SupportEmailLabel" Content="{local:Loc SupportEmail}" Target="{Binding ElementName=SupportEmailInput}" Style="{StaticResource SupportLabel}"/>
                            <TextBox x:Name="SupportEmailInput" Style="{StaticResource SupportInput}" MaxLength="320" FlowDirection="LeftToRight" AutomationProperties.LabeledBy="{Binding ElementName=SupportEmailLabel}"/>
                            <Label x:Name="SupportSubjectLabel" Content="{local:Loc SupportSubject}" Target="{Binding ElementName=SupportSubjectInput}" Style="{StaticResource SupportLabel}"/>
                            <TextBox x:Name="SupportSubjectInput" Style="{StaticResource SupportInput}" MaxLength="200" AutomationProperties.LabeledBy="{Binding ElementName=SupportSubjectLabel}"/>
                            <Label x:Name="SupportMessageLabel" Content="{local:Loc SupportMessage}" Target="{Binding ElementName=SupportMessageInput}" Style="{StaticResource SupportLabel}"/>
                            <TextBox x:Name="SupportMessageInput" Style="{StaticResource SupportInput}" MaxLength="5000" MinHeight="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.LabeledBy="{Binding ElementName=SupportMessageLabel}"/>
                            <TextBlock Text="{local:Loc SupportPrivacy}" Foreground="{StaticResource DimFg}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Expander Header="{local:Loc SupportDetails}" Foreground="{StaticResource BarFg}" Margin="0,0,0,16">
                                <TextBlock x:Name="SupportDetailsText" Foreground="{StaticResource BarFg}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </Expander>
                            <Button x:Name="SupportSendBtn" Content="{local:Loc SupportSend}" Click="SendSupport_Click" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0" Padding="20,10"/>
                        </StackPanel>
                        <TextBlock x:Name="SupportStatusText" Visibility="Collapsed" Foreground="{StaticResource BarFg}" FontSize="14" TextWrapping="Wrap" Margin="0,16,0,0" Focusable="True" AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="SupportAnotherBtn" Content="{local:Loc SupportSendAnother}" Click="SendAnother_Click" Style="{StaticResource AccentButton}" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="20,10"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
