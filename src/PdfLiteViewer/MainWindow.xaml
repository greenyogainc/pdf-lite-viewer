<Window x:Class="PdfLiteViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PdfLiteViewer"
        Title="{local:Loc AppTitle}"
        Width="1100" Height="850"
        Background="#FF404040"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BarBg" Color="#FF2B2B2B"/>
        <SolidColorBrush x:Key="BarFg" Color="#FFDDDDDD"/>

        <Style TargetType="Button" x:Key="BarButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BarFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton" x:Key="ModeButton">
            <Setter Property="Foreground" Value="{StaticResource BarFg}"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1F5B94"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton" x:Key="BarToggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BarFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1F5B94"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chapter tree (dark) -->
        <Style TargetType="ToggleButton" x:Key="ExpandToggle">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Width="16" Height="16" Background="{TemplateBinding Background}">
                            <TextBlock x:Name="Glyph" Text="▸" FontSize="10" Foreground="{StaticResource BarFg}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate x:Key="ChapterTemplate" DataType="{x:Type local:ChapterItem}"
                                  ItemsSource="{Binding Children}">
            <TextBlock x:Name="ChapterTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Title}"/>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsNavigable}" Value="False">
                    <Setter TargetName="ChapterTitle" Property="Foreground" Value="#FF9A9A9A"/>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <Style TargetType="TreeViewItem" x:Key="DarkTreeViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BarFg}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <!-- Virtualizing panel so large expanded outlines don't realize every child. -->
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="19"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Style="{StaticResource ExpandToggle}"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Border x:Name="Bd" Grid.Column="1" CornerRadius="3"
                                    Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"
                                            VirtualizingPanel.IsVirtualizing="True"
                                            VirtualizingPanel.VirtualizationMode="Recycling"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1F5B94"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border x:Name="ToolbarHost" DockPanel.Dock="Top" Background="{StaticResource BarBg}">
            <DockPanel Margin="8,5" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource BarButton}" Content="{local:Loc Open}" Click="Open_Click" ToolTip="{local:Loc OpenTooltip}"/>
                    <!-- Non-directional contents glyph: keeps the toolbar compact for long translations. -->
                    <ToggleButton x:Name="ChapterToggle" Style="{StaticResource BarToggle}" Content="☰"
                                  Checked="ChapterToggle_Changed" Unchecked="ChapterToggle_Changed"
                                  ToolTip="{local:Loc ChaptersTooltip}"
                                  AutomationProperties.Name="{local:Loc Chapters}"/>
                    <Rectangle Width="1" Fill="#FF4A4A4A" Margin="6,2"/>
                    <RadioButton x:Name="ModeFacing" Style="{StaticResource ModeButton}" Content="{local:Loc Facing}" GroupName="mode"
                                 IsChecked="True" Checked="Mode_Checked" ToolTip="{local:Loc FacingTooltip}"/>
                    <RadioButton x:Name="ModeSingle" Style="{StaticResource ModeButton}" Content="{local:Loc Single}" GroupName="mode"
                                 Checked="Mode_Checked" ToolTip="{local:Loc SingleTooltip}"/>
                    <RadioButton x:Name="ModeContinuous" Style="{StaticResource ModeButton}" Content="{local:Loc Scroll}" GroupName="mode"
                                 Checked="Mode_Checked" ToolTip="{local:Loc ScrollTooltip}"/>
                    <Rectangle Width="1" Fill="#FF4A4A4A" Margin="6,2"/>
                    <!-- NoMirror: "◀"/"▶" must keep their literal meaning regardless of UI language. -->
                    <StackPanel Orientation="Horizontal" Style="{StaticResource NoMirror}">
                        <Button Style="{StaticResource BarButton}" Content="◀" Click="Prev_Click" ToolTip="{local:Loc PrevPageTooltip}"/>
                        <TextBox x:Name="PageBox" Width="44" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 Background="#FF1E1E1E" Foreground="{StaticResource BarFg}" BorderBrush="#FF4A4A4A"
                                 KeyDown="PageBox_KeyDown" FontSize="13"/>
                        <TextBlock x:Name="PageCountText" Foreground="{StaticResource BarFg}"
                                   VerticalAlignment="Center" Margin="6,0" FontSize="13"/>
                        <Button Style="{StaticResource BarButton}" Content="▶" Click="Next_Click" ToolTip="{local:Loc NextPageTooltip}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource BarButton}" Content="−" Click="ZoomOut_Click" ToolTip="{local:Loc ZoomOutTooltip}"/>
                    <TextBlock x:Name="ZoomText" Text="100%" Foreground="{StaticResource BarFg}"
                               VerticalAlignment="Center" MinWidth="44" TextAlignment="Center" FontSize="13"/>
                    <Button Style="{StaticResource BarButton}" Content="+" Click="ZoomIn_Click" ToolTip="{local:Loc ZoomInTooltip}"/>
                    <Button Style="{StaticResource BarButton}" Content="{local:Loc Fit}" Click="Fit_Click" ToolTip="{local:Loc FitTooltip}"/>
                    <!-- NoMirror: clockwise glyph must keep its meaning in RTL layouts. -->
                    <StackPanel Orientation="Horizontal" Style="{StaticResource NoMirror}">
                        <Button Style="{StaticResource BarButton}" Content="↻" Click="Rotate_Click"
                                ToolTip="{local:Loc RotateTooltip}"
                                AutomationProperties.Name="{local:Loc RotateTooltip}"/>
                    </StackPanel>
                    <Rectangle Width="1" Fill="#FF4A4A4A" Margin="6,2"/>
                    <Button Style="{StaticResource BarButton}" Content="{local:Loc Print}" Click="Print_Click" ToolTip="{local:Loc PrintTooltip}"/>
                    <Rectangle Width="1" Fill="#FF4A4A4A" Margin="6,2"/>
                    <Button Style="{StaticResource BarButton}" Content="⛶" Click="Fullscreen_Click" ToolTip="{local:Loc FullscreenTooltip}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ChapterColumn" Width="0" MinWidth="0" MaxWidth="520"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chapter sidebar: deliberately NOT NoMirror — it follows the UI culture's reading
                 direction, so under Arabic it docks on the right with RTL indentation. -->
            <Border x:Name="ChapterPane" Grid.Column="0" Background="{StaticResource BarBg}" Visibility="Collapsed">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="8,6">
                        <TextBlock Text="{local:Loc Chapters}" Foreground="{StaticResource BarFg}"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource BarButton}" Content="✕" Padding="6,2"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="ChapterClose_Click"
                                ToolTip="{local:Loc CloseChaptersTooltip}"
                                AutomationProperties.Name="{local:Loc CloseChaptersTooltip}"/>
                    </Grid>
                    <Grid Margin="4,0,4,4">
                        <TreeView x:Name="ChapterTree" Background="Transparent" BorderThickness="0"
                                  Foreground="{StaticResource BarFg}"
                                  Padding="0,0,0,4"
                                  ItemContainerStyle="{StaticResource DarkTreeViewItem}"
                                  ItemTemplate="{StaticResource ChapterTemplate}"
                                  SelectedItemChanged="ChapterTree_SelectedItemChanged"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Item"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed"/>
                        <TextBlock x:Name="ChapterLoadingText" Text="{local:Loc LoadingChapters}"
                                   Foreground="#FF9A9A9A" FontSize="13" Margin="8,4"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBlock x:Name="ChapterEmptyText" Text="{local:Loc NoChapters}"
                                   Foreground="#FF9A9A9A" FontSize="13" Margin="8,4"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBlock x:Name="ChapterFailedText" Text="{local:Loc ChapterLoadFailed}"
                                   Foreground="#FF9A9A9A" FontSize="13" Margin="8,4"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="ChapterSplitter" Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False" Visibility="Collapsed"/>

            <Grid Grid.Column="2">
                <!-- NoMirror: the scroll frame and its rendered pages must never mirror. -->
                <ScrollViewer x:Name="Scroller"
                              Style="{StaticResource NoMirror}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="Scroller_ScrollChanged"
                              PreviewMouseWheel="Scroller_PreviewMouseWheel"
                              Focusable="True"
                              Background="Transparent">
                    <ItemsControl x:Name="PagesHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" Margin="8"
                                        Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45"/>
                                    </Border.Effect>
                                    <Image Source="{Binding Image}" Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint"
                           Text="{local:Loc EmptyHint}"
                           Foreground="#FF9A9A9A" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
